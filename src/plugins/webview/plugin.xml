<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
  xmlns:android="http://schemas.android.com/apk/res/android" id="cordova-plugin-nobicode-webview" version="2.0.0">
  <name>cordova-plugin-nobicode-webview</name>
  <description>NobiCode WebView Plugin API - Create and manage isolated WebView instances</description>
  <license>Apache 2.0</license>

  <platform name="android">

    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="NobiCodeWebView">
        <param name="android-package" value="com.nobidev.webview.WebViewPlugin"/>
      </feature>
    </config-file>

    <config-file parent="./application" target="AndroidManifest.xml">
      <activity android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode" android:name="com.nobidev.webview.WebViewActivity" android:theme="@style/Theme.App.Activity" android:windowSoftInputMode="adjustResize" android:resizeableActivity="true">
      </activity>
    </config-file>

    <!-- Multi-profile WebView support powers incognito isolation. It is already
         a transitive dependency of the Cordova framework, declared explicitly
         here so this plugin compiles against it. -->
    <framework src="androidx.webkit:webkit:1.14.0" />

    <source-file src="src/android/com/nobidev/webview/WebViewPlugin.java" target-dir="src/com/nobidev/webview"/>
    <source-file src="src/android/com/nobidev/webview/WebViewInstance.java" target-dir="src/com/nobidev/webview"/>
    <source-file src="src/android/com/nobidev/webview/WebViewActivity.java" target-dir="src/com/nobidev/webview"/>
    <source-file src="src/android/com/nobidev/webview/WebViewOptions.java" target-dir="src/com/nobidev/webview"/>
    <source-file src="src/android/com/nobidev/webview/ProfileManager.java" target-dir="src/com/nobidev/webview"/>

  </platform>
</plugin>
